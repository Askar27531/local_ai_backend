{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill_app://config_schemas/npc_behavior_v1.json",
  "title": "NPC Behavior Configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature", "rules", "thresholds", "npc_overrides", "npc_groups"],
  "properties": {
    "schema_version": {"const": 1},
    "feature": {"const": "npc_behavior"},
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repeated_question"],
      "properties": {
        "repeated_question": {
          "type": "object",
          "additionalProperties": false,
          "required": ["window_seconds", "base_increment"],
          "properties": {
            "window_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
            "base_increment": {"type": "integer", "minimum": 1, "maximum": 100}
          }
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warning", "refuse"],
      "properties": {
        "warning": {"type": "integer", "minimum": 0, "maximum": 99},
        "refuse": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    },
    "npc_overrides": {"type": "object"},
    "npc_groups": {"type": "object"}
  }
}
